#!/bin/bash

SHELL_DIR=$(pwd)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export tp="$SCRIPT_DIR/tools"
export ap="$SCRIPT_DIR"
cd "$SCRIPT_DIR"/app/open_pro
source "$tp"/e2s config && source "$tp"/e2s system_config

if [[ $1 == -version ]]; then
    echo $version
elif [[ $1 == -h ]]; then
    cat help
elif [[ $1 == -c ]]; then
    $ap/op config
elif [[ $1 == -* ]]; then
    ./bin/cmd "$@"
else
    if [[ $1 != http* ]]; then
        abs_path=$($tp/path_transform "$1" "$SHELL_DIR")
        [[ -e "$abs_path" ]] && abs_path="$(realpath "$abs_path")" || ./libexec/touch_file "$abs_path"
    else
        abs_path="$1"
    fi
    [[ $app_null_enable == "true" && ${!#} == "null" ]] && exit 

    ./app "$abs_path"  "${@:2}"
fi
