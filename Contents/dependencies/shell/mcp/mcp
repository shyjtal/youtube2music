#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export tp="$SCRIPT_DIR/tools"
export ap="$SCRIPT_DIR"
cd "$SCRIPT_DIR"/app/media_compress
source "$tp"/e2s config && source "$tp"/e2s system_config

if [[ $1 == --version ]]; then
    echo $version
elif [[ $1 == -c ]]; then
    $ap/op config $config_app
elif [[ $1 == -h ]]; then
    cat help
else
    export temp=$($tp/multi_file) && mkdir $temp
    ./preprocess "$@"
    [[ -d $temp ]] && rm -r $temp
fi
