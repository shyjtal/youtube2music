config_app=txt

default_compress=b
default_param=0.5

intelligence_video_scale_compress=true
default_compress_mov=s
default_param_mov=auto

# 1920 -> 1080
# default_param_mov=0.56
# 1080->720
# default_param_mov=0.5625

default_compress_mp4=s
default_param_mp4=0.5625

default_compress_m4a=b
default_param_m4a=128

default_compress_mp3=b
default_param_mp3=128

default_compress_heic=j
default_param_heic=50

default_compress_jpg=j
default_param_jpg=50

default_compress_jpeg=j
default_param_jpeg=50

default_compress_png=j
default_param_png=50

default_compress_gif=r
default_param_gif=0.7

protect_dim_gif=0
forbid_dim_gif=0

# mcp will auto device if accelerat
auto_encoder_accelerate=true

video_scale_flags=lanczos

# when use "mcp -s? $o_path" for video, auto increase bitrate to protect the frames
video_bitrate_compensate=1.3

