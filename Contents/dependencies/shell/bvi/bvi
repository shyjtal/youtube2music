#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export tp="$SCRIPT_DIR/tools"
export ap="$SCRIPT_DIR"
cd "$SCRIPT_DIR"/app/"BILIBILI INFO"
source "$tp"/e2s config && source "$tp"/e2s system_config
export local_path=$HOME/"$local_path"

if [[ -d "$ap/app/bilibili info" ]]; then
    app_type=app
    cd "$ap/app/bilibili info"
else
    app_type=dev
    cd "$ap/dev/bilibili info"
fi

if [[ $app_type == app ]]; then
    if [ -z $1 ]; then
        "$local_path"/app
    elif [ $1 = "-h" ]; then
        cat help
    elif [ $1 = "-c" ]; then
        $ap/op "$local_path"/bv
    elif [ $1 = "-l" ]; then
        cat  "$local_path"/bv
    else
        ./app "$@"
    fi
else
    ./app "$@"
fi
