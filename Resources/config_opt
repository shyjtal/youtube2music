config_opt() {
    
    local config_file=$1
    local config_key=$2
    local config_value=$3

    if [[ $# -ge 3 && -z $3 ]]; then
        # sed -i '' "/^$config_key=/d" "$config_file"
        awk -v k="$config_key" 'index($0, k"=") != 1' "$config_file" > "$config_file.tmp" \
    && mv "$config_file.tmp" "$config_file"
    elif [[ -n $config_value ]]; then
        if grep -q "^$config_key=" "$config_file"; then
            sed -i '' "s|^$config_key=.*|$config_key=$config_value|" "$config_file"
        else
            echo "$config_key=$config_value" >> "$config_file"
        fi
    else
        awk -F '=' -v k="$config_key" '$1==k {print $2}' "$config_file"
    fi
    
}

if [[ $1 == -h ]]; then
    echo "## tool help
config_opt key -> read
config_opt key vaule -> set
config_opt key "" -> remove"
else
    config_opt "$@"
fi
